{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planning-factory.local/contracts/setup-stages-report-v1.schema.json",
  "title": "Planning Factory - Report di setup-stages v1",
  "description": "Uscita JSON di planning-factory setup-stages (-o). Le chiavi opzionali compaiono solo con l'opzione che le produce. Mai pubblicabile su ERP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "bookings",
    "kpis",
    "audit_violations"
  ],
  "properties": {
    "sequence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bookings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/booking"
      }
    },
    "kpis": {
      "type": [
        "object",
        "null"
      ],
      "$ref": "#/$defs/kpis"
    },
    "audit_violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unplanned": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unplanned"
      }
    },
    "task_modes": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "forward",
          "backward"
        ]
      }
    },
    "backward": {
      "$ref": "#/$defs/backward"
    },
    "just_in_time_tail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimental",
        "delayed",
        "rejected",
        "baseline"
      ],
      "properties": {
        "experimental": {
          "type": "boolean"
        },
        "delayed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delayed"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline": {
          "$ref": "#/$defs/kpis"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "evaluated",
        "rejected",
        "improved",
        "baseline"
      ],
      "properties": {
        "objective": {
          "enum": [
            "delivery",
            "setup",
            "flow",
            "gap"
          ]
        },
        "evaluated": {
          "type": "integer",
          "minimum": 1
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "improved": {
          "type": "boolean"
        },
        "evaluated_on": {
          "const": "backward plan"
        },
        "baseline": {
          "$ref": "#/$defs/kpis"
        },
        "baseline_gap_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "selected_gap_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "multistart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts",
        "best_start_index",
        "evaluated",
        "rejected_starts",
        "seed"
      ],
      "properties": {
        "starts": {
          "type": "integer",
          "minimum": 1
        },
        "best_start_index": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 1
        },
        "rejected_starts": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches_previous_bookings",
        "setup_releases"
      ],
      "properties": {
        "matches_previous_bookings": {
          "type": "boolean"
        },
        "setup_releases": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "kpis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "late_orders",
        "makespan_seconds",
        "setup_seconds",
        "tardiness_seconds"
      ],
      "properties": {
        "late_orders": {
          "type": "integer",
          "minimum": 0
        },
        "makespan_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "setup_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "tardiness_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "stage",
        "segments",
        "allocations"
      ],
      "properties": {
        "phase_id": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "setup",
            "run"
          ]
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          }
        },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_id",
              "occupancy_bps"
            ],
            "properties": {
              "resource_id": {
                "type": "string"
              },
              "occupancy_bps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    "delayed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "seconds"
      ],
      "properties": {
        "phase_id": {
          "type": "string"
        },
        "seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unplanned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "code",
        "detail"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "code": {
          "enum": [
            "NO_CANDIDATE",
            "PREDECESSOR_UNPLANNED",
            "NEST_MEMBER_UNPLANNED"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "backward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option",
        "delayed_runs",
        "setup_gaps_seconds",
        "setup_releases"
      ],
      "properties": {
        "option": {
          "const": "A"
        },
        "delayed_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delayed"
          }
        },
        "setup_gaps_seconds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "setup_releases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "baseline": {
          "$ref": "#/$defs/kpis"
        }
      }
    }
  }
}
